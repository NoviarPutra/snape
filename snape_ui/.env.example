# Backend Host Configuration
# Use 127.0.0.1:8000 for Desktop/iOS Simulator/Web
# Use 10.0.2.2:8000 for Android Emulator
# Use your LAN IP (e.g. 192.168.1.x:8000) for physical devices
BACKEND_HOST=127.0.0.1:8000

# Protocols (http/https for REST, ws/wss for WebSockets)
HTTP_SCHEME=http
WS_SCHEME=ws

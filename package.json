{
  "name": "snape",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "./scripts/dev_be.sh",
    "test": "cd snape_be && .venv/bin/pytest -v",
    "lint": "cd snape_be && .venv/bin/ruff check . && .venv/bin/mypy app",
    "format": "cd snape_be && .venv/bin/ruff format . && .venv/bin/ruff check --fix .",
    "migrate": "cd snape_be && .venv/bin/python scripts/apply_supabase_migration.py",
    "hermes:curate": "cd snape_be && .venv/bin/python scripts/hermes_materials_curator.py",
    "hermes:curate:all": "cd snape_be && .venv/bin/python scripts/hermes_materials_curator.py --level all",
    "hermes:curate:a1": "cd snape_be && .venv/bin/python scripts/hermes_materials_curator.py --level A1",
    "hermes:curate:a2": "cd snape_be && .venv/bin/python scripts/hermes_materials_curator.py --level A2",
    "hermes:curate:b1": "cd snape_be && .venv/bin/python scripts/hermes_materials_curator.py --level B1",
    "hermes:curate:b2": "cd snape_be && .venv/bin/python scripts/hermes_materials_curator.py --level B2",
    "hermes:curate:c1": "cd snape_be && .venv/bin/python scripts/hermes_materials_curator.py --level C1",
    "hermes:curate:c2": "cd snape_be && .venv/bin/python scripts/hermes_materials_curator.py --level C2",
    "hermes:news": "cd snape_be && .venv/bin/python scripts/hermes_news_orchestrator.py",
    "hermes:news:all": "cd snape_be && .venv/bin/python scripts/hermes_news_orchestrator.py --category all",
    "hermes:news:politics": "cd snape_be && .venv/bin/python scripts/hermes_news_orchestrator.py --category politics",
    "hermes:news:general": "cd snape_be && .venv/bin/python scripts/hermes_news_orchestrator.py --category general",
    "hermes:news:music": "cd snape_be && .venv/bin/python scripts/hermes_news_orchestrator.py --category music",
    "hermes:news:creators": "cd snape_be && .venv/bin/python scripts/hermes_news_orchestrator.py --category creator_trends",
    "vault:push": "cd /home/budiawan/obsidian-stack/brain && git add . && git commit -m \"chore(vault): update study materials [$(date +'%Y-%m-%d %H:%M')]\" || true && git push origin main",
    "ui:dev": "cd snape_ui && flutter run -t lib/main_dev.dart --flavor dev",
    "ui:prod": "cd snape_ui && flutter run -t lib/main_prod.dart --flavor prod",
    "ui:test": "cd snape_ui && flutter test",
    "ui:analyze": "cd snape_ui && flutter analyze",
    "build:apk:dev": "cd snape_ui && flutter build apk -t lib/main_dev.dart --flavor dev",
    "build:apk:prod": "cd snape_ui && flutter build apk -t lib/main_prod.dart --flavor prod --release",
    "build:appbundle": "cd snape_ui && flutter build appbundle -t lib/main_prod.dart --flavor prod --release",
    "build:ios:prod": "cd snape_ui && flutter build ios -t lib/main_prod.dart --flavor prod --no-codesign",
    "build:ipa:prod": "cd snape_ui && flutter build ipa -t lib/main_prod.dart --flavor prod"
  }
}

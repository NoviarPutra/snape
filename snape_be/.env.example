# Database / Supabase Configuration
# Format: postgresql+asyncpg://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB_NAME]?ssl=require
DATABASE_URL="postgresql+asyncpg://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres?ssl=require"

# Individual Supabase DB Credentials (Optional alternative)
SUPABASE_DB_HOST="db.your-project-ref.supabase.co"
SUPABASE_DB_PORT="5432"
SUPABASE_DB_USER="postgres"
SUPABASE_DB_PASSWORD="your-supabase-password"
SUPABASE_DB_NAME="postgres"

# OmniRoute AI Gateway Configuration
OMNIROUTE_BASE_URL="http://localhost:20128/v1"
OMNIROUTE_API_KEY="your-omniroute-api-key-here"
OMNIROUTE_MODEL="antigravity/gemini-3.7-flash-high"

# Voice / TTS Settings (Disabled by default for fast text streaming)
ENABLE_TTS=false
TTS_PROVIDER="edge_tts"
EDGE_TTS_VOICE="en-US-AndrewMultilingualNeural"
